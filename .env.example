# Client-side app mode. Use "mock" for local-only testing or "api" for OpenAI-backed evaluation.
VITE_AI_MODE=mock

# Vercel serverless endpoint used by the browser app when VITE_AI_MODE=api.
VITE_AI_ENDPOINT=/api/evaluate

# Server-side only. Add this in Vercel project environment variables, never in WordPress HTML.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_REASONING_EFFORT=low
